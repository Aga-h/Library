# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# graphify knowledge-graph output — tracked on purpose, so the graph survives a
# container wipe and Claude can query it instead of re-reading the whole tree.
# Two exceptions:
# (gitignore has no trailing comments - a trailing # becomes part of the pattern)
# absolute path to a container-local interpreter, wrong on any other machine:
/graphify-out/.graphify_python
# debug screenshot, not part of graphify's output:
/graphify-out/graph-preview.png
