generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── BOOKS ───────────────────────────────────────────────────────────────────

model Book {
  id          String      @id @default(cuid())
  title       String
  author      String
  status      BookStatus  @default(WANT_TO_READ)
  owned       Boolean     @default(false)
  language    Language    @default(ENGLISH)
  publisher   String?
  pages       Int
  // Progress. Status is derived from this against `pages`, never set by hand.
  pagesRead   Int         @default(0)
  coverImage  String?
  rating      Float?
  notes       String?
  timesReread Int         @default(0)
  seriesId    String?
  series      BookSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([seriesId])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([language, createdAt(sort: Desc)])
}

model BookSeries {
  id         String        @id @default(cuid())
  name       String
  universeId String?
  universe   BookUniverse? @relation(fields: [universeId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  books      Book[]

  // SetNull, not Cascade: deleting a universe must not delete the books inside it.
  @@unique([universeId, name])
  @@index([universeId])
}

model BookUniverse {
  id        String       @id @default(cuid())
  name      String       @unique
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  series    BookSeries[]
}

enum BookStatus {
  READ
  READING
  WANT_TO_READ
}

// ─── ANIME ───────────────────────────────────────────────────────────────────

model Anime {
  id              String       @id @default(cuid())
  title           String
  studio          String?
  status          AnimeStatus  @default(PLAN_TO_WATCH)
  episodes        Int?
  episodesWatched Int          @default(0)
  episodeDuration Int          @default(24)
  season          AnimeSeason?
  year            Int?
  language        Language     @default(JAPANESE)
  coverImage      String?
  rating          Float?
  notes           String?
  timesRewatched  Int          @default(0)
  // Which season of its series this row is. Distinct from `season` above, which is the
  // AIRING season (Winter/Spring/Summer/Fall). Nullable: a standalone entry has none.
  seasonNumber    Int?
  seriesId        String?
  series          AnimeSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([language, createdAt(sort: Desc)])
  @@index([seriesId])
  @@index([seriesId, seasonNumber])
}

enum AnimeStatus {
  WATCHING
  COMPLETED
  PLAN_TO_WATCH
}

enum AnimeSeason {
  WINTER
  SPRING
  SUMMER
  FALL
}

// ─── MOVIES ──────────────────────────────────────────────────────────────────

model Movie {
  id             String         @id @default(cuid())
  title          String
  director       String?
  studio         String?
  status         MovieStatus    @default(WANT_TO_WATCH)
  runtime        Int
  year           Int?
  language       Language       @default(ENGLISH)
  coverImage     String?
  rating         Float?
  notes          String?
  timesRewatched Int            @default(0)
  universeId     String?
  universe       MovieUniverse? @relation(fields: [universeId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([universeId])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// Movies stop at two levels — universe and film. There is no series tier: a
// franchise is the universe, and its films sit directly inside it.
model MovieUniverse {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movies    Movie[]
}

enum MovieStatus {
  WATCHED
  WANT_TO_WATCH
  DROPPED
}

// ─── TV SHOWS ────────────────────────────────────────────────────────────────

model TvShow {
  id              String    @id @default(cuid())
  title           String
  creator         String?
  network         String?
  status          TvStatus  @default(PLAN_TO_WATCH)
  totalEpisodes   Int?
  episodesWatched Int       @default(0)
  episodeRuntime  Int       @default(45)
  year            Int?
  language        Language  @default(ENGLISH)
  coverImage      String?
  rating          Float?
  notes           String?
  timesRewatched  Int       @default(0)
  // Which season of its series this row is. Nullable: a standalone show has none.
  seasonNumber    Int?
  seriesId        String?
  series          TvSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([seriesId])
  @@index([seriesId, seasonNumber])
}

enum TvStatus {
  WATCHING
  COMPLETED
  PLAN_TO_WATCH
}

// ─── GAMES ───────────────────────────────────────────────────────────────────

model Game {
  id                   String       @id @default(cuid())
  title                String
  developer            String?
  publisher            String?
  status               GameStatus   @default(PLAN_TO_PLAY)
  platform             GamePlatform @default(PC)
  emulated             Boolean      @default(false)
  hoursPlayed          Float        @default(0)
  achievementsUnlocked Int          @default(0)
  achievementsTotal    Int?
  coverImage           String?
  rating               Float?
  notes                String?
  steamAppId           Int?         @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([platform, createdAt(sort: Desc)])
}

enum GameStatus {
  PLAYING
  COMPLETED
  PLAN_TO_PLAY
  DROPPED
  PLATINUM
}

enum GamePlatform {
  PC
  MAC
  STEAM_DECK
  PS5
  PS4
  PS3
  PS2
  PS1
  PSP
  PS_VITA
  XBOX_SERIES_X
  XBOX_SERIES_S
  XBOX_ONE_X
  XBOX_ONE_S
  XBOX_ONE
  XBOX_360
  XBOX
  SWITCH_2
  SWITCH
  SWITCH_OLED
  SWITCH_LITE
  WII_U
  WII
  GAMECUBE
  N64
  SNES
  NES
  NINTENDO_3DS
  DS
  GBA
  GBC
  GAMEBOY
  SEGA_DREAMCAST
  SEGA_SATURN
  SEGA_GENESIS
  GAME_GEAR
  IOS
  ANDROID
  OTHER
}

// ─── MANGA ───────────────────────────────────────────────────────────────────

model Manga {
  id            String      @id @default(cuid())
  title         String
  author        String
  artist        String?
  publisher     String?
  status        MangaStatus @default(PLAN_TO_READ)
  format        MangaFormat @default(MANGA)
  totalVolumes  Int?
  volumesRead   Int         @default(0)
  totalChapters Int?
  chaptersRead  Int         @default(0)
  // Still releasing: no final chapter/volume count exists yet, so it can never be COMPLETED.
  ongoing       Boolean     @default(false)
  language      Language    @default(JAPANESE)
  coverImage    String?
  rating        Float?
  notes         String?
  timesReread   Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([language, createdAt(sort: Desc)])
}

enum MangaFormat {
  MANGA
  MANHWA
  MANHUA
}

enum MangaStatus {
  READING
  COMPLETED
  PLAN_TO_READ
}

// ─── COMICS ──────────────────────────────────────────────────────────────────

// Four-level hierarchy: Publisher → Universe → Title → Issue.
// Reading progress and ratings are derived from the issues, never stored on a parent.

model ComicPublisher {
  id        String          @id @default(cuid())
  name      String          @unique
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  universes ComicUniverse[]
}

model ComicUniverse {
  id          String         @id @default(cuid())
  name        String
  publisherId String
  publisher   ComicPublisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  titles      ComicTitle[]

  // @@unique's leading column already indexes publisherId — no separate index needed.
  @@unique([publisherId, name])
}

model ComicTitle {
  id         String        @id @default(cuid())
  name       String
  universeId String
  universe   ComicUniverse @relation(fields: [universeId], references: [id], onDelete: Cascade)
  author     String?
  artist     String?
  language   Language      @default(ENGLISH)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  issues     ComicIssue[]

  @@unique([universeId, name])
}

model ComicIssue {
  id          String     @id @default(cuid())
  titleId     String
  comicTitle  ComicTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  // Float so #0 prologues and #1.5 interstitials sort correctly between whole numbers.
  issueNumber Float
  name        String?
  read        Boolean    @default(false)
  owned       Boolean    @default(false)
  coverImage  String?
  rating      Float?
  releaseDate DateTime?
  timesReread Int        @default(0)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // @@unique doubles as the (titleId, issueNumber) ordering index.
  @@unique([titleId, issueNumber])
}

// ─── ARTICLES ────────────────────────────────────────────────────────────────

model Article {
  id          String        @id @default(cuid())
  title       String
  author      String?
  publication String?
  url         String?
  status      ArticleStatus @default(WANT_TO_READ)
  wordCount   Int
  language    Language      @default(ENGLISH)
  coverImage  String?
  rating      Float?
  notes       String?
  timesReread Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([language, createdAt(sort: Desc)])
}

enum ArticleStatus {
  READ
  WANT_TO_READ
}

// ─── WARDROBE ────────────────────────────────────────────────────────────────

model Garment {
  id         String      @id @default(cuid())
  name       String
  type       GarmentType @default(OTHER)
  brand      String?
  color      String?
  colorGroup ColorGroup  @default(MIXED)
  materials  String // e.g. "80% cotton, 20% polyester"
  washMethod WashMethod  @default(MACHINE)
  maxTemp    WashTemp    @default(W40)
  washCycle  WashCycle   @default(NORMAL)
  spinLevel  SpinLevel   @default(NORMAL)
  dryMethod  DryMethod   @default(TUMBLE_LOW)
  wornCount  Int         @default(0)
  lastWashed DateTime?
  image      String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([type, wornCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

enum GarmentType {
  TOPS
  BOTTOMS
  OUTERWEAR
  UNDERWEAR
  SOCKS
  ACTIVEWEAR
  FORMALWEAR
  ACCESSORIES
  OTHER
}

enum ColorGroup {
  WHITE
  LIGHT
  DARK
  VIVID
  MIXED
}

enum WashMethod {
  MACHINE
  HAND
  DRY_CLEAN
  DO_NOT_WASH
}

enum WashTemp {
  COLD
  W30
  W40
  W60
  W90
}

enum WashCycle {
  NORMAL
  GENTLE
}

enum SpinLevel {
  NORMAL
  REDUCED
  NONE
}

enum DryMethod {
  TUMBLE_HIGH
  TUMBLE_MEDIUM
  TUMBLE_LOW
  AIR_LINE
  AIR_FLAT
  AIR_DRIP
  DRY_CLEAN
  DO_NOT_DRY
}

// ─── FINANCES ────────────────────────────────────────────────────────────────

model FinanceConfig {
  id            String   @id @default("global")
  monthlyBudget Float    @default(0)
  updatedAt     DateTime @updatedAt
}

model Expense {
  id          String          @id @default(cuid())
  // Supplied by the offline queue. Unique, so a POST replayed by a concurrent sync,
  // a second tab, or a retry after a lost response can never insert the same expense
  // twice. Nullable because rows created before this existed have none, and Postgres
  // permits many NULLs in a unique index.
  clientId    String?         @unique
  year        Int
  month       Int
  category    ExpenseCategory
  amount      Float
  description String?
  createdAt   DateTime        @default(now())

  @@index([year, month, createdAt(sort: Desc)])
}

model AdditionalIncome {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  amount      Float
  description String?
  createdAt   DateTime @default(now())

  @@index([year, month, createdAt(sort: Desc)])
}

enum ExpenseCategory {
  FOOD
  BOOKS
  EDUCATION
  ENTERTAINMENT
  CLOTHING
  SUBSCRIPTIONS
  SELF_CARE
  TRANSPORTATION
  OTHER
  CASH
}

model Subscription {
  id             String   @id @default(cuid())
  name           String
  amount         Float
  startYear      Int
  startMonth     Int
  cancelledYear  Int?
  cancelledMonth Int?
  createdAt      DateTime @default(now())
}

// ─── SERIES ──────────────────────────────────────────────────────────────────

// Groups seasons of an anime. Universe is optional — a series with no universe shows on
// the anime main page; one inside a universe is reached by opening that universe.
model AnimeSeries {
  id         String         @id @default(cuid())
  name       String
  universeId String?
  universe   AnimeUniverse? @relation(fields: [universeId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  anime      Anime[]

  // SetNull, not Cascade: deleting a universe must not delete the anime inside it.
  @@unique([universeId, name])
  @@index([universeId])
}

model AnimeUniverse {
  id        String        @id @default(cuid())
  name      String        @unique
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  series    AnimeSeries[]
}

// A series groups seasons. Its universe is optional — a series with no universe shows on
// the TV main page; one inside a universe is reached by opening that universe instead.
model TvSeries {
  id         String      @id @default(cuid())
  name       String
  universeId String?
  universe   TvUniverse? @relation(fields: [universeId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  shows      TvShow[]

  // SetNull, not Cascade: deleting a universe must not delete the series inside it.
  // Note Postgres allows repeated NULLs here, so two universe-less series may share a name.
  @@unique([universeId, name])
  @@index([universeId])
}

model TvUniverse {
  id        String     @id @default(cuid())
  name      String     @unique
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  series    TvSeries[]
}

// ─── SHARED ENUMS ────────────────────────────────────────────────────────────

enum Language {
  ENGLISH
  SPANISH
  FRENCH
  GERMAN
  ITALIAN
  PORTUGUESE
  TURKISH
  ARABIC
  RUSSIAN
  JAPANESE
  CHINESE
  KOREAN
}

// ── Calendar ─────────────────────────────────────────────────────────────────
// Day plans are dealt onto real dates. A date's kind (school or holiday) is always DERIVED
// from the terms, days off and the weekend rule — never stored — because terms get edited and
// a stored kind would quietly disagree with the calendar afterwards.

/// A thing you study. No hours and no place in a day — you pick one when you start a session,
/// and the session pays XP to the stats it trains.
model Module {
  id        String         @id @default(cuid())
  title     String         @unique
  notes     String?
  /// The stats this module trains, 1-3 of them. The API enforces the range; a module with none
  /// could never pay anything.
  stats     Stat[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sessions  StudySession[]

  @@index([title])
}

// ─── TASKS & STATS ───────────────────────────────────────────────────────────

model XpAward {
  id             String       @id @default(cuid())
  studySessionId String
  studySession   StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  stat           Stat
  amount         Int
  createdAt      DateTime     @default(now())

  // Paying the same session twice is the one thing that must never happen.
  @@unique([studySessionId, stat])
  @@index([stat])
}

/// One sitting of study. With a module, it trains that module's stats; without one, three stats
/// rolled at random — for one-off work not worth making a module for.
model StudySession {
  id          String    @id @default(cuid())
  /// Local calendar date it belongs to, so it lands in the right day/week/month totals.
  date        DateTime  @db.Date
  moduleId    String?
  /// SetNull, not Cascade: deleting a module must not erase the hours already studied under it.
  module      Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  /// The module's name when the session ran. Kept because SetNull would otherwise leave a
  /// deleted module's sessions looking exactly like free ones. Null means it really was free.
  moduleTitle String?
  /// The stats this session pays, fixed when it starts. A snapshot, not a lookup: re-pointing a
  /// module's stats later must not rewrite what past sessions earned.
  stats       Stat[]
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  /// Filled in when the session ends.
  seconds     Int?
  createdAt   DateTime  @default(now())
  xpAwards    XpAward[]

  @@index([date])
  @@index([moduleId])
}

enum Stat {
  STRENGTH
  DEXTERITY
  CONSTITUTION
  INTELLIGENCE
  WISDOM
  CHARISMA
  RESOLVE
  INTUITION
  COMPOSURE
  WILLPOWER
  ESSENCE
  LOGIC
  RESONANCE
  MAGIC
}

// ─── AP COURSES ──────────────────────────────────────────────────────────────

/// A College Board AP course you are taking. Units are seeded from the official Course and Exam
/// Description; the tracker only records which of them you have finished.
model ApCourse {
  id        String   @id @default(cuid())
  /// Full official name, e.g. "AP Physics C: Mechanics".
  name      String   @unique
  /// Short label for tight spaces, e.g. "Physics C: Mech".
  shortName String
  /// Courses College Board treats as one continuous sequence share a series, and the tracker
  /// shows them together. Physics C is the case: Mechanics is units 1-7 and E&M is units 8-13,
  /// two separate exams numbered as one course framework.
  series    String?
  /// Display order across the tracker.
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     ApUnit[]

  @@index([position])
}

model ApUnit {
  id          String    @id @default(cuid())
  courseId    String
  course      ApCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Unit number as College Board numbers it.
  number      Int
  title       String
  /// Exam weighting as printed in the CED, e.g. "10-13%". Free text: the format varies by course
  /// and some units are not weighted at all.
  weighting   String?
  /// When you ticked it off. Null means not finished — the tick is the timestamp.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([courseId, number])
  @@index([courseId])
}

// ─── STUDY: SAT VOCABULARY ───────────────────────────────────────────────────

model VocabWord {
  id        String         @id @default(cuid())
  word      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  meanings  VocabMeaning[]

  @@index([word])
}

/// One sense of a word. A word with three senses produces three questions, each asking about
/// one of them.
model VocabMeaning {
  id        String          @id @default(cuid())
  wordId    String
  word      VocabWord       @relation(fields: [wordId], references: [id], onDelete: Cascade)
  text      String
  /// 1, 2, 3 … within the word, so the list keeps the order it was imported in.
  position  Int
  createdAt DateTime        @default(now())
  questions VocabQuestion[]

  @@unique([wordId, position])
  @@index([wordId])
}

/// One sitting of the test. Starting a new run is what resets the three categories: they are
/// just the verdicts on the current run's questions.
model VocabRun {
  id         String          @id @default(cuid())
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  questions  VocabQuestion[]

  @@index([startedAt])
}

model VocabQuestion {
  id         String        @id @default(cuid())
  runId      String
  run        VocabRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The meaning being asked about — the correct answer.
  meaningId  String
  meaning    VocabMeaning  @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  /// Order within the run. Fixed at generation so refreshing mid-test does not reshuffle.
  position   Int
  /// The four options as meaning ids, already shuffled, the correct one among them. Never holds
  /// another meaning of the same word — that would be a second correct answer.
  optionIds  String[]
  /// What was picked. Null until answered.
  chosenId   String?
  verdict    VocabVerdict?
  answeredAt DateTime?

  @@unique([runId, position])
  @@index([runId])
  @@index([meaningId])
}

enum VocabVerdict {
  DONE
  AMBIGUOUS
  TO_REVIEW
}
